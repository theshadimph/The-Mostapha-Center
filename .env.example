APP_NAME="مركز المصطفى"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# First super-admin account, created/updated by `php artisan db:seed --class=Database\\Seeders\\AdminUserSeeder`.
ADMIN_NAME="مدير المكتبة"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Shown on the public "Contact us" page and used as the recipient for the
# contact form. Leave blank to hide the corresponding section / skip sending.
CENTER_PHONE=
CENTER_WHATSAPP=
CENTER_ADDRESS=
CENTER_MAP_URL=
CONTACT_EMAIL=

# Book search (SearchController). The automated test suite always uses the
# "collection" driver instead (configured in phpunit.xml), so no Meilisearch
# server is required to run `php artisan test`. After deploying, run
# `php artisan scout:sync-index-settings` once and then
# `php artisan scout:import "App\Models\Book"` to build the index.
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL is the recommended production database (see CLAUDE.md / README).
# The automated test suite always uses an in-memory SQLite database
# regardless of this setting (configured in phpunit.xml) — no MySQL
# server is required to run `php artisan test`.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mostapha_center
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" is fine for local development (mail is written to the log file
# instead of sent). Switch to smtp/ses/postmark/resend before deploying.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
